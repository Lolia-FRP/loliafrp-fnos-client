#!/bin/sh
set -eu
case "${wizard_keep_data:-true}" in
  true|1) exit 0;;
  false|0)
    : "${TRIM_PKGVAR:?}" "${TRIM_PKGETC:?}" "${TRIM_PKGTMP:?}"
    for path in "$TRIM_PKGVAR" "$TRIM_PKGETC" "$TRIM_PKGTMP"; do
      case "$path" in /|/var|/var/apps|/vol[0-9]|/vol[0-9][0-9]|'') printf '%s\n' '数据目录校验失败，已取消清理。' > "${TRIM_TEMP_LOGFILE:-/dev/null}"; exit 1;; esac
    done
    rm -f "$TRIM_PKGVAR/database.sqlite" "$TRIM_PKGVAR/database.sqlite-wal" "$TRIM_PKGVAR/database.sqlite-shm" "$TRIM_PKGVAR/master.key" "$TRIM_PKGETC/client-id.txt" "$TRIM_PKGETC/client-id.txt.tmp"
    rm -rf "$TRIM_PKGVAR/core" "$TRIM_PKGVAR/certificates" "$TRIM_PKGVAR/logs" "$TRIM_PKGTMP/runtime"
    ;;
  *) printf '%s\n' '无效的数据保留选项。' > "${TRIM_TEMP_LOGFILE:-/dev/null}"; exit 1;;
esac
